// GanaBol — Esquema de base de datos del servidor
//
// Sistema móvil de gestión ganadera para explotaciones bovinas tradicionales
// del departamento de Santa Cruz, Bolivia.
//
// El esquema reproduce el diseño del documento «05 - Diagrama de base de
// datos», conservando sus nombres de tabla y de columna, sus restricciones de
// dominio y sus reglas de integridad referencial.
//
// Alcance implementado: Incremento 1 (identidad, accesos y sincronización), el
// inventario bovino, el pesaje morfométrico y el historial sanitario con su
// calendario de alertas. Las entidades de comercialización, reproducción y
// evaluación ponderada están diseñadas en el documento citado y corresponden a
// incrementos posteriores.
//
// El diccionario de datos del documento incluye la columna `estado_sync` en las
// tablas operativas. Esa columna pertenece a la réplica del dispositivo, que es
// la que necesita distinguir lo que aún no ha consolidado; en el servidor el
// seguimiento equivalente lo lleva `registro_sync`, de modo que el estado de
// consolidación no se duplica en dos lugares con autoridad distinta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Dominios categóricos
//
// El diseño los define como restricciones CHECK sobre columnas de texto. Aquí
// se expresan como enumeraciones, que Prisma traduce a tipos enumerados de
// PostgreSQL: la restricción es la misma y queda verificada además en tiempo
// de compilación.
// ---------------------------------------------------------------------------

enum Rol {
  administrador
  personal_campo
  veterinario
  propietario
}

enum Sexo {
  M
  H
}

enum CategoriaAnimal {
  ternero
  vaquillona
  novillo
  vaca
  toro
}

enum FaseManejo {
  crianza
  destete
  engorde
}

enum EstadoAnimal {
  activo
  vendido
  baja
}

enum TipoEventoSanitario {
  vacunacion
  desparasitacion
  tratamiento
  diagnostico
}

/// Un plan sanitario programa aplicaciones preventivas y curativas, pero no
/// diagnósticos: un diagnóstico se registra cuando ocurre, no se calendariza.
enum TipoEventoPlan {
  vacunacion
  desparasitacion
  tratamiento
}

enum TipoAlerta {
  sanitaria
  reproductiva
}

enum EstadoAlerta {
  pendiente
  atendida
  vencida
}

enum OperacionSync {
  alta
  modificacion
  baja
}

enum EstadoSync {
  pendiente
  sincronizado
  conflicto
}

// ---------------------------------------------------------------------------
// Tablas
// ---------------------------------------------------------------------------

/// Personas que acceden al sistema.
model Usuario {
  idUsuario    String  @id @map("id_usuario") @db.Char(26)
  nombre       String  @db.VarChar(120)
  email        String  @unique @db.VarChar(120)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  rol          Rol     @default(personal_campo)
  activo       Boolean @default(true)

  ultimoAccesoEn DateTime? @map("ultimo_acceso_en") @db.Timestamptz()
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz()
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz()

  animales Animal[]

  @@map("usuario")
}

/// Ubicaciones físicas del establecimiento.
model Potrero {
  idPotrero    String   @id @map("id_potrero") @db.Char(26)
  nombre       String   @db.VarChar(100)
  superficieHa Decimal? @map("superficie_ha") @db.Decimal(8, 2)

  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  animales Animal[]

  @@index([eliminado])
  @@map("potrero")
}

/// Animales del hato.
///
/// El identificador es un ULID generado en el dispositivo, lo que permite dar
/// de alta un animal sin conexión y consolidarlo después sin coordinar con el
/// servidor. La marca `actualizadoEn` la fija el servidor y ordena los cambios
/// para la resolución de conflictos; `eliminado` es la marca de baja que
/// propaga la eliminación a los demás dispositivos.
model Animal {
  idAnimal String @id @map("id_animal") @db.Char(26)

  idUsuario String  @map("id_usuario") @db.Char(26)
  usuario   Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)

  idPotrero String?  @map("id_potrero") @db.Char(26)
  potrero   Potrero? @relation(fields: [idPotrero], references: [idPotrero], onDelete: SetNull)

  caravana        String          @unique @db.VarChar(20)
  categoria       CategoriaAnimal
  raza            String?         @db.VarChar(40)
  sexo            Sexo
  fechaNacimiento DateTime?       @map("fecha_nacimiento") @db.Date
  fase            FaseManejo
  estado          EstadoAnimal    @default(activo)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz()
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  pesajes          Pesaje[]
  eventosSanitarios EventoSanitario[]
  alertas          Alerta[]

  @@index([estado, eliminado])
  @@index([actualizadoEn])
  @@index([idPotrero])
  @@map("animal")
}

/// Mediciones morfométricas y peso estimado.
///
/// El peso no se mide: se calcula con la fórmula de Schaeffer a partir del
/// perímetro torácico y el largo corporal, y se almacena junto a las medidas
/// que lo originaron. Conservar las medidas y no solo el resultado permite
/// recalcular el historial completo si la constante se recalibra, que es
/// justamente lo que el diseño prevé para el ganado cebú de la zona.
model Pesaje {
  idPesaje String @id @map("id_pesaje") @db.Char(26)

  idAnimal String @map("id_animal") @db.Char(26)
  animal   Animal @relation(fields: [idAnimal], references: [idAnimal], onDelete: Restrict)

  fecha             DateTime @db.Date
  perimetroToracico Decimal  @map("perimetro_toracico") @db.Decimal(6, 2)
  largoCorporal     Decimal  @map("largo_corporal") @db.Decimal(6, 2)
  pesoEstimado      Decimal  @map("peso_estimado") @db.Decimal(6, 2)

  /// Constante de la fórmula con la que se obtuvo este peso. Se guarda en el
  /// registro para que una recalibración posterior no invalide la trazabilidad
  /// de los pesos ya estimados.
  constante Decimal @db.Decimal(8, 2)

  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  @@index([idAnimal, fecha])
  @@index([actualizadoEn])
  @@map("pesaje")
}

/// Eventos sanitarios del hato.
model EventoSanitario {
  idEvento String @id @map("id_evento") @db.Char(26)

  idAnimal String @map("id_animal") @db.Char(26)
  animal   Animal @relation(fields: [idAnimal], references: [idAnimal], onDelete: Restrict)

  /// Protocolo que este evento cumple, cuando se registra en respuesta a uno.
  ///
  /// Refinamiento surgido en la implementación: el diccionario de datos
  /// identificaba el evento solo por su tipo, de modo que dos protocolos de
  /// vacunación distintos sobre el mismo animal —antiaftosa y carbunclo, por
  /// ejemplo— compartían el mismo «último evento de vacunación» y aplicar uno
  /// reiniciaba el conteo del otro. La referencia es opcional porque el
  /// productor también registra eventos que no responden a ningún protocolo,
  /// como el tratamiento de una herida.
  idPlan String?        @map("id_plan") @db.Char(26)
  plan   PlanSanitario? @relation(fields: [idPlan], references: [idPlan], onDelete: SetNull)

  tipo        TipoEventoSanitario
  producto    String?             @db.VarChar(100)
  dosis       String?             @db.VarChar(40)
  fecha       DateTime            @db.Date
  responsable String?             @db.VarChar(120)

  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  alertasAtendidas Alerta[]

  @@index([idAnimal, fecha])
  @@index([idAnimal, idPlan, fecha])
  @@index([actualizadoEn])
  @@map("evento_sanitario")
}

/// Protocolos sanitarios configurables que originan las alertas del calendario.
model PlanSanitario {
  idPlan String @id @map("id_plan") @db.Char(26)

  nombre      String           @db.VarChar(100)
  categoria   CategoriaAnimal?
  tipoEvento  TipoEventoPlan   @map("tipo_evento")
  descripcion String?          @db.VarChar(200)

  /// Días entre aplicaciones del protocolo. El sistema programa la siguiente
  /// aplicación sumando este intervalo a la fecha del último evento del tipo.
  periodicidadDias Int @map("periodicidad_dias")

  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  alertas Alerta[]
  eventos EventoSanitario[]

  @@index([eliminado])
  @@map("plan_sanitario")
}

/// Tareas sanitarias y reproductivas próximas o vencidas generadas por el
/// sistema.
///
/// Una alerta no se borra al atenderse: pasa a estado `atendida` y conserva el
/// evento que la cerró. Así el calendario queda auditable, que es lo que exige
/// el criterio de aceptación del requisito.
model Alerta {
  idAlerta String @id @map("id_alerta") @db.Char(26)

  idAnimal String @map("id_animal") @db.Char(26)
  animal   Animal @relation(fields: [idAnimal], references: [idAnimal], onDelete: Cascade)

  idPlan String?        @map("id_plan") @db.Char(26)
  plan   PlanSanitario? @relation(fields: [idPlan], references: [idPlan], onDelete: SetNull)

  idEventoCierre String?          @map("id_evento_cierre") @db.Char(26)
  eventoCierre   EventoSanitario? @relation(fields: [idEventoCierre], references: [idEvento], onDelete: SetNull)

  tipo             TipoAlerta
  descripcion      String?      @db.VarChar(200)
  fechaProgramada  DateTime     @map("fecha_programada") @db.Date
  estado           EstadoAlerta @default(pendiente)

  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz()
  eliminado     Boolean  @default(false)

  /// Una alerta vigente por animal y protocolo: la regeneración del calendario
  /// debe actualizar la alerta existente, no acumular duplicados cada vez que
  /// se ejecuta.
  @@unique([idAnimal, idPlan, fechaProgramada])
  @@index([estado, fechaProgramada])
  @@index([actualizadoEn])
  @@map("alerta")
}

/// Control del estado de sincronización de cada entidad operativa.
model RegistroSync {
  idRegistro  String        @id @map("id_registro") @db.Char(26)
  entidad     String        @db.VarChar(30)
  idEntidad   String        @map("id_entidad") @db.Char(26)
  operacion   OperacionSync
  estado      EstadoSync    @default(pendiente)
  marcaTiempo DateTime      @map("marca_tiempo") @db.Timestamptz()

  @@index([entidad, estado])
  @@index([marcaTiempo])
  @@map("registro_sync")
}
